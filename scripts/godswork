#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_root"
export PYTHONPATH="$project_root${PYTHONPATH:+:$PYTHONPATH}"
export XDG_CACHE_HOME="$project_root/.tools/cache"
export PYTHONPYCACHEPREFIX="$project_root/.tools/cache/pycache"
exec "$project_root/.tools/harness-venv/bin/python" -m godswork "$@"
