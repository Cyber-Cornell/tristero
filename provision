#!/usr/bin/env bash
# provision: set up this Ubuntu 24.04 desktop as a Tristero master or worker.
# Run from a checkout of this repo as the desktop user:
#   sudo ./provision worker [name]     # prints the line to paste on the master
#   sudo ./provision master
# Safe to rerun. Agents run as the desktop user, who gets passwordless sudo.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")" && pwd)
ROLE=${1:-}
WORKER=${2:-$(hostname -s)}
OC_VERSION=2.2.7
PORT=${TRISTERO_PORT:-4096}
AGENT_USER=${TRISTERO_USER:-${SUDO_USER:-}}

die() { echo "provision: $*" >&2; exit 1; }
step() { echo "==> $*"; }

[[ $ROLE == master || $ROLE == worker ]] || die "usage: sudo ./provision master|worker [name]"
[ "$(id -u)" = 0 ] || die "run with sudo"
[[ -n $AGENT_USER && $AGENT_USER != root ]] || die "run via sudo from the desktop user's account (or set TRISTERO_USER)"
[[ $WORKER =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "worker name must be lowercase letters, digits, and dashes"
. /etc/os-release
[ "$ID" = ubuntu ] || die "Ubuntu only (this is $ID)"
[ "$VERSION_ID" = 24.04 ] || echo "provision: warning: tested on Ubuntu 24.04, this is $VERSION_ID" >&2
GROUP=$(id -gn "$AGENT_USER")
HOME_DIR=$(getent passwd "$AGENT_USER" | cut -d: -f6)
# Model: TRISTERO_MODEL if given, else keep what this machine already uses, else the free default.
MODEL=${TRISTERO_MODEL:-$(jq -r ".model // empty" "$HOME_DIR/.config/opencode/opencode.json" 2>/dev/null || true)}
MODEL=${MODEL:-opencode/deepseek-v4.1-flash-free}
as_user() { sudo -u "$AGENT_USER" HOME="$HOME_DIR" "$@"; }

step "base packages"
apt-get update -qq
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl jq ca-certificates openssl >/dev/null

step "passwordless sudo for $AGENT_USER (agents may install and run anything)"
echo "$AGENT_USER ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/90-tristero
chmod 440 /etc/sudoers.d/90-tristero
visudo -cqf /etc/sudoers.d/90-tristero

install_opencode() {
  if opencode --version 2>/dev/null | grep -q "v$OC_VERSION\$"; then return; fi
  step "OpenCode $OC_VERSION"
  local meta tmp; tmp=$(mktemp -d)
  meta=$(curl -fsSL "https://registry.npmjs.org/@opencode/cli-linux-x64/$OC_VERSION")
  curl -fsSL -o "$tmp/oc.tgz" "$(jq -r .dist.tarball <<<"$meta")"
  [ "sha512-$(openssl dgst -sha512 -binary "$tmp/oc.tgz" | base64 -w0)" = "$(jq -r .dist.integrity <<<"$meta")" ] \
    || die "OpenCode download failed its checksum"
  tar -C "$tmp" -xzf "$tmp/oc.tgz"
  install -m 755 "$tmp/package/bin/opencode" /usr/local/bin/opencode
  rm -rf "$tmp"
}

install_tools() {
  : # Later: the team's standard tool subset (nmap, ...). Agents can already apt-get anything else.
}

keep_awake() { # the desktop must never sleep, lock, blank, or log out mid-competition
  step "desktop: no sleep, lock, blanking, or logout"
  systemctl mask -q sleep.target suspend.target hibernate.target hybrid-sleep.target
  command -v dconf >/dev/null || return 0 # no GNOME, nothing more to do
  mkdir -p /etc/dconf/profile /etc/dconf/db/local.d/locks
  printf 'user-db:user\nsystem-db:local\n' > /etc/dconf/profile/user
  cat > /etc/dconf/db/local.d/00-tristero <<'EOF'
[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/desktop/screensaver]
lock-enabled=false
idle-activation-enabled=false
ubuntu-lock-on-suspend=false

[org/gnome/desktop/lockdown]
disable-lock-screen=true

[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'
idle-dim=false
EOF
  # Locked, so per-user settings can't turn any of it back on.
  awk -F= '/^\[/ { gsub(/[][]/, ""); dir = $0 } /=/ { print "/" dir "/" $1 }' \
    /etc/dconf/db/local.d/00-tristero > /etc/dconf/db/local.d/locks/tristero
  dconf update
}

install_opencode
install_tools
keep_awake

step "$ROLE agent for $AGENT_USER (model $MODEL)"
as_user mkdir -p "$HOME_DIR/.config/opencode/agents"
as_user cp "$ROOT/agents/$ROLE.md" "$HOME_DIR/.config/opencode/agents/"
jq -n --arg m "$MODEL" --arg a "$ROLE" \
  '{"$schema": "https://opencode.ai/config.json", model: $m, default_agent: $a, update: "disable"}' \
  | as_user tee "$HOME_DIR/.config/opencode/opencode.json" >/dev/null

launcher() { # app-menu entry that opens the agent in a terminal on this desktop
  printf '[Desktop Entry]\nType=Application\nName=%s\nExec=%s\nIcon=utilities-terminal\nTerminal=true\n' "$1" "$2" \
    > "/usr/share/applications/tristero-$ROLE.desktop"
}

if [ "$ROLE" = master ]; then
  install -m 755 "$ROOT/bin/fleet" /usr/local/bin/fleet
  as_user mkdir -p "$HOME_DIR/.config/tristero"
  [ -f "$HOME_DIR/.config/tristero/fleet.json" ] || echo '{"workers": []}' | as_user tee "$HOME_DIR/.config/tristero/fleet.json" >/dev/null
  chmod 600 "$HOME_DIR/.config/tristero/fleet.json"
  launcher "Tristero master" "sh -c 'cd ~ && exec opencode'"
  cat <<EOF

== Master ready (agent user: $AGENT_USER)
   1. On each worker, run: sudo ./provision worker
   2. Paste the "fleet add ..." line each worker prints into a terminal here.
   3. Check them with: fleet workers
   4. Open "Tristero master" from the app menu, or run: cd ~ && opencode
EOF
  exit 0
fi

# Worker: a password-protected OpenCode server the master drives over HTTP.
mkdir -p /etc/tristero
if ! grep -q '^OPENCODE_SERVER_PASSWORD=' /etc/tristero/worker.env 2>/dev/null; then
  echo "OPENCODE_SERVER_PASSWORD=$(openssl rand -hex 24)" > /etc/tristero/worker.env
fi
chown "root:$GROUP" /etc/tristero/worker.env
chmod 640 /etc/tristero/worker.env
PASSWORD=$(sed -n 's/^OPENCODE_SERVER_PASSWORD=//p' /etc/tristero/worker.env)

cat > /etc/systemd/system/tristero-worker.service <<EOF
[Unit]
Description=Tristero worker (OpenCode server)
After=network-online.target
Wants=network-online.target

[Service]
User=$AGENT_USER
Group=$GROUP
EnvironmentFile=/etc/tristero/worker.env
Environment=HOME=$HOME_DIR
WorkingDirectory=$HOME_DIR
ExecStart=/usr/local/bin/opencode serve --hostname 0.0.0.0 --port $PORT
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF

# Lets the student watch, interrupt, or take over the session the master is driving.
# Opens the session the master drives (titled "tristero"), creating it if the master hasn't yet.
cat > /usr/local/bin/tristero-attach <<EOF
#!/bin/sh
. /etc/tristero/worker.env
cd "\$HOME"
export OPENCODE_PASSWORD=\$OPENCODE_SERVER_PASSWORD
api() { curl -fs -u "opencode:\$OPENCODE_PASSWORD" -H 'content-type: application/json' "\$@"; }
sid=\$(api "http://127.0.0.1:$PORT/api/session?search=tristero&limit=50" \\
  | jq -r '[.data[] | select(.title == "tristero")] | max_by(.time.updated) | .id // empty')
[ -n "\$sid" ] || sid=\$(api -X POST http://127.0.0.1:$PORT/api/session -d '{"title":"tristero","agent":"worker"}' | jq -r '.data.id // empty')
exec opencode --server http://127.0.0.1:$PORT \${sid:+--session "\$sid"} "\$@"
EOF
chmod 755 /usr/local/bin/tristero-attach
launcher "Tristero worker agent" tristero-attach

step "starting tristero-worker service"
systemctl daemon-reload
systemctl enable -q tristero-worker
systemctl restart tristero-worker
for _ in $(seq 30); do
  curl -fs -u "opencode:$PASSWORD" "http://127.0.0.1:$PORT/api/info" >/dev/null && break; sleep 1
done || true
curl -fs -u "opencode:$PASSWORD" "http://127.0.0.1:$PORT/api/info" >/dev/null \
  || die "worker server not answering; see: journalctl -u tristero-worker"

IP=$(ip -4 route get 1.1.1.1 2>/dev/null | grep -oP 'src \K\S+' || true)
OTHERS=$(ip -4 -o addr show scope global | awk '{ sub(/\/.*/, "", $4); print $4 }' | grep -vx "${IP:-none}" | tr '\n' ' ' || true)
cat <<EOF

== Worker '$WORKER' ready (agent user: $AGENT_USER)
   URL       http://${IP:-THIS-IP}:$PORT
   Password  $PASSWORD
   On the master, run:
     fleet add $WORKER http://${IP:-THIS-IP}:$PORT $PASSWORD
${OTHERS:+   Other addresses on this machine: $OTHERS
}   Watch or take over this agent: open "Tristero worker agent" from the app menu, or run tristero-attach
EOF
